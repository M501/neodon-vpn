#!/bin/bash
# 90-neodon-resume (2026-10-02 v2): restore the user's VPN intent after
# network-up / sleep-resume. Runs as root (NetworkManager dispatcher).
# Intent file: ~/.desired (written on every toggle incl. 'off'; heal/ExecStopPost
# never touches it, so a crash-during-sleep keeps the intent and gets restored).
IFACE="$1"; ACTION="$2"
[ "$IFACE" = "wlan0" ] || exit 0
case "$ACTION" in up|connectivity-change) : ;; *) exit 0 ;; esac
MODE=$(cat /home/m26/AI/singbox/.desired 2>/dev/null || echo off)
case "$MODE" in smart|full|proxy) : ;; *) exit 0 ;; esac
SVC="sing-box.service"
[ "$MODE" = "full" ] && SVC="sing-box-full.service"
[ "$MODE" = "proxy" ] && SVC="sing-box-proxy.service"
STATE=$(runuser -u m26 -- env XDG_RUNTIME_DIR=/run/user/1000 systemctl --user is-active "$SVC" 2>/dev/null | head -1)
[ "$STATE" = "active" ] && exit 0
sleep 5
runuser -u m26 -- env XDG_RUNTIME_DIR=/run/user/1000 bash /home/m26/AI/singbox/singbox-toggle.sh "$MODE" >/dev/null 2>&1
logger -t neon-resume "restored VPN mode=$MODE after action=$ACTION on $IFACE"
