/* Neodon VPN — allow the active wheel user to manage systemd-resolved
   without password prompts (dns-fix path; prevents polkit dialog spam). */
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.resolve1.") === 0 &&
        subject.isInGroup("wheel") && subject.active) {
        return polkit.Result.YES;
    }
});
